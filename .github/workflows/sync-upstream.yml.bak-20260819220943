name: Sync with upstream

on:
  schedule:
    - cron: '0 8 * * *'   # 每天 08:00 UTC（北京时间 16:00）
  workflow_dispatch: {}   # 支持手动触发

permissions:
  contents: write

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          ref: main
          fetch-depth: 0

      - name: Sync upstream code
        run: |
          git config user.name "sync-bot"
          git config user.email "sync-bot@users.noreply.github.com"
          git remote add upstream https://github.com/NousResearch/hermes-agent.git
          git fetch upstream main
          git merge upstream/main --no-commit --no-edit || {
            echo "merge 冲突，中止（需手动处理）"
            exit 1
          }
          # 丢弃上游对 .github/ 的变更（含暂存区），保持本仓库的 sync workflow
          git restore --staged --worktree --source=HEAD -- .github
          git commit -m "Sync upstream main ($(git log -1 --format=%h upstream/main))"
          git push origin main
